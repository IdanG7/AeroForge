{
  "name": "aeroforge",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "opencv4",
      "default-features": false,
      "features": [
        "calib3d",
        "fs",
        "intrinsics",
        "jpeg",
        "png",
        "thread",
        {
          "name": "dshow",
          "platform": "windows"
        },
        {
          "name": "msmf",
          "platform": "windows"
        }
      ]
    },
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "opengl3-binding"
      ]
    },
    "glfw3",
    "yaml-cpp",
    "fmt",
    "spdlog",
    "catch2",
    "eigen3",
    "nlohmann-json",
    "msgpack"
  ]
}
